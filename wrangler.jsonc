{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "curia-landing",
  "account_id": "48f381bf59212dbd98d2b424ba4b9a04",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-23",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "vars": {
    "CONTACT_SOURCE": "agenticengineering.online"
  },

  "routes": [
    {
      "pattern": "agenticengineering.online",
      "custom_domain": true
    }
  ],

  "observability": {
    "enabled": true
  }

  // Secrets (set via `wrangler secret put`, NOT here):
  //   TWENTY_API_KEY          (required) - bearer token for self-hosted Twenty CRM
  //   TWENTY_BASE_URL         (required) - https://twenty.agenticengineering.lat
}
