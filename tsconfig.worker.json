{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["worker/**/*"],
  "exclude": ["node_modules", "dist", "src"]
}
